<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>netstandard2.0</TargetFrameworks>
    <Authors>dpvreony</Authors>
    <Description>Collection of packages for assisting in QA during .NET software development on Github.</Description>
    <PackageLicense>MIT</PackageLicense>
    <PackageTags>Roslyn Analyzer</PackageTags>
    <DebugType>full</DebugType>
    <DebugSymbols>True</DebugSymbols>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <DevelopmentDependency>true</DevelopmentDependency>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <NoWarn>$(NoWarn);NU1702;NU5100;NU5128</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.SourceLink.GitHub" Version="10.0.401" />
  </ItemGroup>

  <ItemGroup>
    <None Include="*.props" Pack="true" PackagePath="build" />
    <None Include="*.targets" Pack="true" PackagePath="build" />
    <None Include="readme.md" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Gripe.QualityAssurancePack\Gripe.QualityAssurancePack.csproj" ExcludeAssets="all" PrivateAssets="all" ReferenceOutputAssembly="false" />
  </ItemGroup>
</Project>
